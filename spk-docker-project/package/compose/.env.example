# Copy this file to .env next to docker-compose.yml before registering the
# project in Container Manager. Keep the image tag in sync with the imported
# image; replace the loopback URL with the exact reverse-proxy origin.
DSHD_IMAGE=dshd-synology:0.2.0
DSHD_PORT=3080
DSHD_DATA_DIR=/volume1/docker/dshd
DSHD_WORKSPACE_DIR=/volume1/dshd-workspace
DSH_PUBLIC_URL=http://127.0.0.1:3080
DSH_TRUSTED_HOST=127.0.0.1
