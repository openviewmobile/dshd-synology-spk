#!/bin/sh
# DSHD management CLI for the DSM package.
#
#   dshd status              show the recorded package/container state
#   dshd token               print the browser login URL (bearer credential)
#   dshd start|stop|restart  control the Compose project (needs root)
#   dshd doctor              preflight: docker, image, arch, disk, port, compose
#   dshd logs [lines]        show container logs (needs root)
#   dshd config              print the configuration file
#   dshd version             print the package version
#
# Install-time symlinks: /usr/local/bin/dshd and /usr/local/bin/dshd-token.
set -u

PKG_NAME="dshd"
PKG_DEST="${SYNOPKG_PKGDEST:-/var/packages/$PKG_NAME/target}"
PKG_VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG_NAME/var}"
PKG_ROOT=$(dirname "$PKG_DEST")
CONFIG_FILE="${DSHD_CONFIG:-$PKG_VAR/config.env}"
COMPOSE_FILE="${DSHD_COMPOSE:-$PKG_DEST/compose/compose.yml}"
CTL="$PKG_ROOT/scripts/start-stop-status"
TOKEN_CMD="$PKG_ROOT/scripts/token"

log() { printf 'dshd: %s\n' "$*"; }
err() { printf 'dshd: %s\n' "$*" >&2; }

config_value() {
  sed -n "s/^$1=//p" "$CONFIG_FILE" 2>/dev/null | tail -n 1 |
    sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//"
}

need_root() {
  if [ "$(id -u)" != "0" ]; then
    err "this action needs root (Docker socket): sudo dshd $1"
    exit 1
  fi
}

resolve_compose() {
  DOCKER_BIN="${DSHD_DOCKER:-}"
  [ -n "$DOCKER_BIN" ] || DOCKER_BIN=$(command -v docker 2>/dev/null || true)
  [ -n "$DOCKER_BIN" ] || DOCKER_BIN=/usr/local/bin/docker
  if "$DOCKER_BIN" compose version >/dev/null 2>&1; then
    COMPOSE_STYLE="compose"
    return 0
  fi
  DC=$(command -v docker-compose 2>/dev/null || true)
  [ -n "$DC" ] || DC=/usr/local/bin/docker-compose
  if [ -x "$DC" ]; then
    DOCKER_BIN="$DC"
    COMPOSE_STYLE="standalone"
    return 0
  fi
  return 1
}

cmd_status() {
  if [ -f "$PKG_VAR/status" ]; then
    if [ -r "$PKG_VAR/status" ]; then
      cat "$PKG_VAR/status"
    else
      err "status file is root-only; run: sudo dshd status"
    fi
  else
    log "no status file yet; start the package first"
  fi
  if [ -x "$CTL" ]; then
    "$CTL" status >/dev/null 2>&1
    code=$?
    case "$code" in
      0) log "status action: running" ;;
      3) log "status action: not running" ;;
      *) log "status action: exit $code" ;;
    esac
    return "$code"
  fi
  return 4
}

cmd_logs() {
  lines="${1:-100}"
  case "$lines" in ''|*[!0-9]*) err "lines must be a number"; exit 1 ;; esac
  if [ ! -f "$CONFIG_FILE" ] || [ ! -f "$COMPOSE_FILE" ]; then
    err "config or compose file is missing"
    exit 1
  fi
  resolve_compose || { err "docker compose not found"; exit 1; }
  if [ "$COMPOSE_STYLE" = "compose" ]; then
    "$DOCKER_BIN" compose --project-name "$PKG_NAME" --env-file "$CONFIG_FILE" -f "$COMPOSE_FILE" logs --tail "$lines" dshd
  else
    "$DOCKER_BIN" --project-name "$PKG_NAME" --env-file "$CONFIG_FILE" -f "$COMPOSE_FILE" logs --tail "$lines" dshd
  fi
}

case "${1:-help}" in
  status)
    cmd_status
    ;;
  token|url)
    exec "$TOKEN_CMD"
    ;;
  start|stop|restart)
    need_root "$1"
    [ -x "$CTL" ] || { err "missing $CTL"; exit 1; }
    if [ "$1" = "restart" ]; then
      "$CTL" stop && exec "$CTL" start
      exit $?
    fi
    exec "$CTL" "$1"
    ;;
  doctor)
    need_root doctor
    exec "$CTL" doctor
    ;;
  logs)
    need_root logs
    cmd_logs "${2:-100}"
    ;;
  config)
    [ -r "$CONFIG_FILE" ] || { err "cannot read $CONFIG_FILE"; exit 1; }
    cat "$CONFIG_FILE"
    ;;
  version)
    sed -n 's/^version="\(.*\)"$/\1/p' "$PKG_ROOT/INFO" 2>/dev/null | head -n 1
    ;;
  help|-h|--help)
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    err "unknown action: $1"
    err "usage: dshd {status|token|start|stop|restart|doctor|logs|config|version}"
    exit 1
    ;;
esac
