# DSHD runtime configuration for the DSM package.
#
# Location on the NAS: /var/packages/dshd/var/config.env
# The package creates this file from config.env.example on first install
# (or from the install wizard) and never overwrites user edits on upgrade.
# Edit it with SSH as an administrator:
#
#   sudo vi /var/packages/dshd/var/config.env
#
# This file is parsed as KEY=value lines by scripts/start-stop-status and
# scripts/dshd (it is NOT executed as a shell script) and passed to
# `docker compose --env-file`. Keep one KEY=value per line, no `export`, no
# spaces around `=`, and put comments on their own lines. Do not put long-lived
# secrets here; dsh stores credentials in its own home directory.

# Container image and tag. Build/import this image on the NAS before starting:
#   docker build -t dshd-synology:0.3.0 .
# The package does not pull automatically, so a missing image fails fast
# instead of silently downloading an unexpected tag. Set DSHD_ALLOW_PULL=yes
# to let `docker compose up` pull the tag when it is missing.
DSHD_IMAGE=dshd-synology:0.3.0
DSHD_ALLOW_PULL=no

# Host loopback port published by Compose. The container always listens on
# 3080; change this only if 3080 is already taken on the NAS.
DSHD_PORT=3080

# Persistent dsh home (profiles, sessions, credentials, logs). Back this up.
# Must be under /volume* (or the package var dir) and must not contain "..".
DSHD_DATA_DIR=/volume1/docker/dshd

# Workspace mounted at /workspace inside the container. Back this up too.
DSHD_WORKSPACE_DIR=/volume1/dshd-workspace

# Public URL printed in the login link and accepted by dsh's Host/Origin fence.
# For direct loopback access (SSH tunnel) keep 127.0.0.1. For DSM reverse
# proxy use the exact HTTPS origin, e.g. https://dsh.example.net, and set
# DSH_TRUSTED_HOST to the same hostname without the scheme/port.
DSH_PUBLIC_URL=http://127.0.0.1:3080
DSH_TRUSTED_HOST=127.0.0.1

# Host-side owner for the data/workspace directories. The current image runs
# dsh as uid/gid 1001, so keep these aligned unless you also rebuild the image.
DSHD_PUID=1001
DSHD_PGID=1001

# Seconds to wait for the "dsh web: ...?token=..." line after `compose up`.
DSHD_START_TIMEOUT=180

# Refuse to start if less than this much free space remains on the data volume.
DSHD_MIN_FREE_MB=2048

# Refuse to run an image built for another CPU architecture unless explicitly
# allowed (emulation is very slow and is not a supported production mode).
DSHD_ALLOW_EMULATION=no

# Container resource limits. Keep these conservative on 2 GB NAS models.
DSHD_MEM_LIMIT=4g
DSHD_CPUS=2.0
DSHD_PIDS_LIMIT=512

# Docker json-file log rotation for the container (not dsh's own logs).
DSHD_LOG_MAX_SIZE=10m
DSHD_LOG_MAX_FILE=3
