{
  "webservice": {
    "services": [
      {
        "service": "dshd",
        "display_name": "DSHD",
        "support_alias": true,
        "support_server": false,
        "type": "reverse_proxy",
        "proxy_target": "http://127.0.0.1:3080",
        "proxy_headers": [
          { "name": "Host", "value": "$host" },
          { "name": "Upgrade", "value": "$http_upgrade" },
          { "name": "Connection", "value": "$connection_upgrade" }
        ],
        "proxy_http_version": 1,
        "connect_timeout": 60,
        "read_timeout": 3600,
        "send_timeout": 3600
      }
    ],
    "portals": [
      {
        "service": "dshd",
        "name": "DSHD",
        "type": "alias",
        "alias": "dshd"
      }
    ],
    "pkg_dir_prepare": []
  }
}
