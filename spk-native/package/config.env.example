# DSHD Native runtime configuration. Created by the installer from the
# Package Center wizard; edit with care and restart the package afterwards.
DSHD_DATA_DIR=/volume1/@appdata/dshd/native/home
DSHD_WORKSPACE_DIR=/volume1/@appdata/dshd/native/workspace
DSHD_PORT=3080
DSH_PUBLIC_URL=http://127.0.0.1:3080
DSH_TRUSTED_HOST=127.0.0.1
DSHD_START_TIMEOUT=300
