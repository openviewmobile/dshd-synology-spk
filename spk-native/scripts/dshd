#!/bin/sh
# DSHD Native management CLI.
set -u
PKG_NAME="dshd"
PKG_DEST="${SYNOPKG_PKGDEST:-/var/packages/$PKG_NAME/target}"
PKG_VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG_NAME/var}"
PKG_ROOT=$(dirname "$PKG_DEST")
CONFIG_FILE="${DSHD_CONFIG:-$PKG_VAR/config.env}"
CTL="$PKG_ROOT/scripts/start-stop-status"
TOKEN_CMD="$PKG_ROOT/scripts/token"
LOG_FILE="$PKG_VAR/log/dsh.log"

log() { printf 'dshd: %s\n' "$*"; }
err() { printf 'dshd: %s\n' "$*" >&2; }

cmd_status() {
  [ -f "$PKG_VAR/status" ] && cat "$PKG_VAR/status" || log "no status file yet"
  "$CTL" status >/dev/null 2>&1; code=$?
  case "$code" in 0) log "status action: running" ;; 3) log "status action: not running" ;; *) log "status action: exit $code" ;; esac
  return "$code"
}

cmd_logs() {
  lines="${1:-100}"
  case "$lines" in ''|*[!0-9]*) err "lines must be a number"; exit 1 ;; esac
  [ -f "$LOG_FILE" ] || { err "no log file: $LOG_FILE"; exit 1; }
  tail -n "$lines" "$LOG_FILE"
}

case "${1:-help}" in
  status) cmd_status ;;
  token|url) exec "$TOKEN_CMD" ;;
  start|stop|restart)
    [ -x "$CTL" ] || { err "missing $CTL"; exit 1; }
    if [ "$1" = restart ]; then "$CTL" stop && exec "$CTL" start; exit $?; fi
    exec "$CTL" "$1"
    ;;
  doctor) exec "$CTL" doctor ;;
  logs) cmd_logs "${2:-100}" ;;
  config) [ -r "$CONFIG_FILE" ] && cat "$CONFIG_FILE" || { err "cannot read $CONFIG_FILE"; exit 1; } ;;
  version) sed -n 's/^version="\(.*\)"$/\1/p' "$PKG_ROOT/INFO" 2>/dev/null | head -n 1 ;;
  help|-h|--help|'')
    cat <<'USAGE'
dshd status              show state
dshd token               print the browser login URL
dshd start|stop|restart  control the native process
dshd doctor              preflight (node, runtime, dirs, port)
dshd logs [lines]        show the dsh log
dshd config              print config.env
dshd version             print package version
USAGE
    ;;
  *) err "unknown command: $1"; exit 1 ;;
esac
